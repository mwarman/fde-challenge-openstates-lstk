{
  "name": "politician-researcher",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:web",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "probe": "npm run probe -w server",
    "sync": "npm run sync -w server",
    "build": "npm run build -w web && npm run typecheck -w server",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "prettier": "^3.10.1"
  }
}
